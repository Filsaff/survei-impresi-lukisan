# ==============================================================================
# AWS Configuration untuk Survei Impresi Lukisan
# ==============================================================================

# 1. AWS RDS PostgreSQL Connection URL
# Format: postgresql://<DB_USER>:<DB_PASSWORD>@<RDS_ENDPOINT>:5432/<DB_NAME>?sslmode=require
DATABASE_URL=postgresql://postgres:your_secure_password@survei-lukisan-db.c123456789.ap-southeast-1.rds.amazonaws.com:5432/postgres?sslmode=require

# 2. AWS S3 Asset Base URL (Tempat 581 file gambar lukisan disimpan)
# Format URL S3 langsung: https://<bucket-name>.s3.<region>.amazonaws.com/paintings
# Atau URL CloudFront jika menggunakan CDN: https://d123456abcdef8.cloudfront.net/paintings
NEXT_PUBLIC_S3_BASE_URL=https://survei-lukisan-assets.s3.ap-southeast-1.amazonaws.com/paintings
